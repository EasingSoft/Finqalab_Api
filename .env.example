# Copy to .env and fill in. Never commit .env.
#
# Your Finqalab client code (this is the "id" you type when logging in to
# the app, e.g. 00000) and your account password.
FQ_USER_ID=
FQ_PASSWORD=

# Optional. The app_build value the client sends to /v1/appVersion/verify-version.
# The server does not currently enforce this, so you rarely need to change it.
FQ_APP_BUILD=170
